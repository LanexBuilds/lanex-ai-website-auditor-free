{
  "name": "Google Sheets New Row Alert",
  "nodes": [
    {
      "parameters": {
        "content": "### \ud83d\ude80 Enjoying this template?\n\nThis is the free, basic version. If you want this custom-built and connected to your specific tools (your CRM, your email, your database), I can do it for you.\n\n\ud83d\udc49 **[Book a 15-min setup session here](https://lanexbuilds.com/book-audit?utm_source=n8n_template&utm_campaign=sheets-new-row-alert)**",
        "height": 300,
        "width": 400
      },
      "id": "sticky-note-id",
      "name": "CTA",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -200
      ]
    },
    {
      "id": "schedule-1",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        100,
        100
      ],
      "parameters": {
        "rule": {
          "type": "cron",
          "cronExpression": "*/5 * * * *"
        }
      }
    },
    {
      "id": "sheets-1",
      "name": "Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 1,
      "position": [
        300,
        100
      ],
      "parameters": {
        "operation": "read",
        "documentId": "your-document-id",
        "sheetName": "Sheet1"
      }
    },
    {
      "id": "if-1",
      "name": "If New Row",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        100
      ],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.isNew}}",
              "value2": true
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Google Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets": {
      "main": [
        [
          {
            "node": "If New Row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}