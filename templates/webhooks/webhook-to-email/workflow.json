{
  "name": "Webhook to Email",
  "nodes": [
    {
      "parameters": {
        "content": "### 🚀 Enjoying this template?\n\nThis is the free, basic version. If you want this custom-built and connected to your specific tools (your CRM, your email, your database), I can do it for you.\n\n👉 **[Book a 15-min setup session here](https://lanexbuilds.com/book-audit?utm_source=n8n_template&utm_campaign=webhook-to-email)**",
        "height": 300,
        "width": 400
      },
      "id": "sticky-note-id",
      "name": "CTA",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -200
      ]
    },
    {
      "parameters": {},
      "id": "webhook-id",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        300,
        200
      ],
      "webhookId": "webhook-to-email-trigger"
    },
    {
      "parameters": {
        "fromEmail": "sender@example.com",
        "toEmail": "recipient@example.com",
        "subject": "New Webhook Alert",
        "text": "={{$json.body.message}}"
      },
      "id": "email-id",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        500,
        200
      ],
      "credentials": {
        "smtp": {
          "id": "smtp-creds-id",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}