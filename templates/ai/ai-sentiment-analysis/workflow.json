{
  "name": "AI Sentiment Analysis",
  "nodes": [
    {
      "parameters": {
        "content": "### 🚀 Enjoying this template?\n\nThis is the free, basic version. If you want this custom-built and connected to your specific tools (your CRM, your email, your database), I can do it for you.\n\n👉 **[Book a 15-min setup session here](https://lanexbuilds.com/book-audit?utm_source=n8n_template&utm_campaign=ai-sentiment-analysis)**",
        "height": 300,
        "width": 400
      },
      "id": "sticky-note-id",
      "name": "CTA",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-200, -200]
    },
    {
      "parameters": {},
      "id": "webhook-id",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 0]
    },
    {
      "parameters": {
        "prompt": "Analyze the sentiment of the following text and return either 'positive', 'neutral', or 'negative'.\n\nText: {{ $json.body.text }}"
      },
      "id": "openai-id",
      "name": "OpenAI Sentiment",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "position": [450, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"sentiment\": \"{{ $json.message.content }}\"\n}"
      },
      "id": "webhook-response-id",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.webhookResponse",
      "typeVersion": 1,
      "position": [650, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "OpenAI Sentiment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Sentiment": {
      "main": [
        [
          {
            "node": "Webhook Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
