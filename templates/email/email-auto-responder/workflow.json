{
  "name": "Email Auto Responder",
  "nodes": [
    {
      "parameters": {
        "content": "### \ud83d\ude80 Enjoying this template?\n\nThis is the free, basic version. If you want this custom-built and connected to your specific tools (your CRM, your email, your database), I can do it for you.\n\n\ud83d\udc49 **[Book a 15-min setup session here](https://lanexbuilds.com/book-audit?utm_source=n8n_template&utm_campaign=email-auto-responder)**",
        "height": 300,
        "width": 400
      },
      "id": "sticky-note-id",
      "name": "CTA",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -200
      ]
    },
    {
      "id": "email-read-1",
      "name": "Email Read Imap",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 1,
      "position": [
        100,
        100
      ],
      "parameters": {
        "mailbox": "INBOX",
        "criteria": "UNSEEN"
      }
    },
    {
      "id": "email-send-1",
      "name": "Email Send",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [
        300,
        100
      ],
      "parameters": {
        "fromEmail": "support@example.com",
        "toEmail": "={{$json.from.address}}",
        "subject": "Re: {{$json.subject}}",
        "text": "Thanks for reaching out! We will get back to you shortly."
      }
    }
  ],
  "connections": {
    "Email Read Imap": {
      "main": [
        [
          {
            "node": "Email Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}