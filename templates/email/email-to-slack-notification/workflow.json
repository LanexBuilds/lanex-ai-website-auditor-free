{
  "name": "Email to Slack Notification",
  "nodes": [
    {
      "parameters": {
        "content": "### 🚀 Enjoying this template?\n\nThis is the free, basic version. If you want this custom-built and connected to your specific tools (your CRM, your email, your database), I can do it for you.\n\n👉 **[Book a 15-min setup session here](https://lanexbuilds.com/book-audit?utm_source=n8n_template&utm_campaign=email-to-slack-notification)**",
        "height": 300,
        "width": 400
      },
      "id": "sticky-note-id",
      "name": "CTA",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -200
      ]
    },
    {
      "parameters": {
        "postProcessAction": "nothing",
        "format": "resolved"
      },
      "id": "email-read-id",
      "name": "Email Read Imap",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        300,
        200
      ],
      "credentials": {
        "imap": {
          "id": "imap-creds-id",
          "name": "IMAP account"
        }
      }
    },
    {
      "parameters": {
        "channel": "general",
        "text": "=New email from {{$json.from.value[0].address}}: {{$json.subject}}"
      },
      "id": "slack-id",
      "name": "Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [
        500,
        200
      ],
      "credentials": {
        "slackApi": {
          "id": "slack-creds-id",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "Email Read Imap": {
      "main": [
        [
          {
            "node": "Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}